{
  "description": "ratchet (Claude adapter): session context, the Stop gate (per-test verification), protection of ratchet state",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ratchet\" hook session-start", "timeout": 30 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ratchet\" hook stop", "timeout": 1800 }] }],
    "PreToolUse": [{ "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ratchet\" hook pre-edit", "timeout": 10 }] }]
  }
}
